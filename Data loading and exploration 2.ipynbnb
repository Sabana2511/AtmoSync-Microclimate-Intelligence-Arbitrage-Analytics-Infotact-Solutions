    {
      "cell_type": "code",
      "source": [
        "# Check the percentage of infinite values in important columns\n",
        "# for each crop type.\n",
        "\n",
        "problem_columns = [\n",
        "    \"Crop_Yield\",\n",
        "    \"Vehicle_Load_Capacity\",\n",
        "    \"Station_Capacity\",\n",
        "    \"Operational_Cost\",\n",
        "    \"Energy_Consumption\",\n",
        "    \"Inventory_Levels\",\n",
        "    \"Efficiency_Ratio\",\n",
        "    \"Route_Distance\",\n",
        "    \"IoT_Sensor_Reading_Light\"\n",
        "]\n",
        "\n",
        "crop_quality_report = []\n",
        "\n",
        "for crop in df[\"Crop_Type\"].unique():\n",
        "\n",
        "    crop_data = df[df[\"Crop_Type\"] == crop]\n",
        "\n",
        "    for column in problem_columns:\n",
        "\n",
        "        infinite_count = crop_data[column].isin(\n",
        "            [float(\"inf\"), float(\"-inf\")]\n",
        "        ).sum()\n",
        "\n",
        "        infinite_percentage = (\n",
        "            infinite_count / len(crop_data)\n",
        "        ) * 100\n",
        "\n",
        "        crop_quality_report.append({\n",
        "            \"Crop_Type\": crop,\n",
        "            \"Column\": column,\n",
        "            \"Records\": len(crop_data),\n",
        "            \"Infinite_Count\": infinite_count,\n",
        "            \"Infinite_Percentage\": infinite_percentage\n",
        "        })\n",
        "\n",
        "crop_quality_df = pd.DataFrame(crop_quality_report)\n",
        "\n",
        "print(\"\\nCrop-wise Data Quality Report:\")\n",
        "print(crop_quality_df)"
      ],
