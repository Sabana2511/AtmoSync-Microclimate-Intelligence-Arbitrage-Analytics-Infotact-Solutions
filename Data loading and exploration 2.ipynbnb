    {
      "cell_type": "code",
      "source": [
        "# Create a complete numerical data-quality report.\n",
        "# This includes missing values, infinite values,\n",
        "# and the percentage of affected records.\n",
        "\n",
        "quality_report = []\n",
        "\n",
        "for column in numeric_columns:\n",
        "\n",
        "    missing_count = df[column].isna().sum()\n",
        "\n",
        "    infinite_count = df[column].isin(\n",
        "        [float(\"inf\"), float(\"-inf\")]\n",
        "    ).sum()\n",
        "\n",
        "    quality_report.append({\n",
        "        \"Column\": column,\n",
        "        \"Missing_Count\": missing_count,\n",
        "        \"Infinite_Count\": infinite_count,\n",
        "        \"Missing_Percentage\": (missing_count / len(df)) * 100,\n",
        "        \"Infinite_Percentage\": (infinite_count / len(df)) * 100\n",
        "    })\n",
        "\n",
        "quality_report_df = pd.DataFrame(quality_report)\n",
        "\n",
        "print(\"\\nComplete Data Quality Report:\")\n",
        "print(quality_report_df)"
      ],
