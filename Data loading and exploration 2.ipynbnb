    {
      "cell_type": "markdown",
      "source": [
        "Spoilage Risk Distribution"
      ],
      "metadata": {
        "id": "QykhjYAowMIG"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Visualize the distribution of spoilage risk.\n",
        "# This helps us understand how spoilage risk is distributed\n",
        "# across the agricultural logistics records.\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.hist(df[\"Spoilage_Risk\"], bins=30)\n",
        "\n",
        "plt.xlabel(\"Spoilage Risk\")\n",
        "plt.ylabel(\"Number of Records\")\n",
        "plt.title(\"Distribution of Spoilage Risk\")\n",
        "\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 487
        },
        "id": "NVOtDDPwuryd",
        "outputId": "923acf0b-08f6-4689-e4e8-fc236a4941a3"
      },
