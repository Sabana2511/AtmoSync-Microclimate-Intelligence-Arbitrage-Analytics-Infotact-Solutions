    {
      "cell_type": "code",
      "source": [
        "# Examine the relationship between route distance and delivery time.\n",
        "# This helps us understand the logistics side of AtmoSync.\n",
        "\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.scatter(\n",
        "    df[\"Route_Distance\"],\n",
        "    df[\"Delivery_Time\"],\n",
        "    alpha=0.3\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Route Distance\")\n",
        "plt.ylabel(\"Delivery Time\")\n",
        "plt.title(\"Route Distance vs Delivery Time\")\n",
        "\n",
        "plt.show()"
      ],
