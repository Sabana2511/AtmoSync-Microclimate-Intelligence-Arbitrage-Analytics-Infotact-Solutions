    {
      "cell_type": "code",
      "source": [
        "# Calculate the number and percentage of infinite values\n",
        "# in every numerical column.\n",
        "\n",
        "numeric_columns = df.select_dtypes(include=\"number\").columns\n",
        "\n",
        "infinity_report = []\n",
        "\n",
        "for column in numeric_columns:\n",
        "\n",
        "    infinite_count = df[column].isin(\n",
        "        [float(\"inf\"), float(\"-inf\")]\n",
        "    ).sum()\n",
        "\n",
        "    infinite_percentage = (infinite_count / len(df)) * 100\n",
        "\n",
        "    infinity_report.append({\n",
        "        \"Column\": column,\n",
        "        \"Infinite_Count\": infinite_count,\n",
        "        \"Infinite_Percentage\": infinite_percentage\n",
        "    })\n",
        "\n",
        "infinity_report_df = pd.DataFrame(infinity_report)\n",
        "\n",
        "print(\"\\nInfinite Value Report:\")\n",
        "print(infinity_report_df)"
      ],
